// SegueIT Projects - data model
// Enumerated values (roles, lookup types, approval states) are stored as strings
// and validated in the application layer (see src/common/constants) so that the
// schema stays simple to evolve. The database is PostgreSQL (Supabase in production).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  /// Pooled connection used by the running app (Supabase: transaction pooler, port 6543).
  url       = env("DATABASE_URL")
  /// Direct connection used by `prisma db push` (Supabase: session pooler or direct, port 5432).
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  logoUrl            String?
  primaryColor       String?
  timezone           String
  weekStartsOn       Int
  workingHoursPerDay Float
  /// Suspended organizations cannot sign in (managed by the platform root account).
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users      User[]
  projects   Project[]
  lookups    Lookup[]
  activities Activity[]
  meetings   Meeting[]
}

/// Tenant users belong to an organization; the platform ROOT account has no organization.
model User {
  id                     String    @id @default(cuid())
  organizationId         String?
  email                  String    @unique
  passwordHash           String
  firstName              String
  lastName               String
  jobTitle               String?
  avatarUrl              String?
  role                   String
  isActive               Boolean   @default(true)
  hourlyRate             Float?
  lastLoginAt            DateTime?
  /// Authenticator app (TOTP) sign-in: encrypted secret, set while setting up; enabled once confirmed.
  twoFactorSecret        String?
  twoFactorEnabledAt     DateTime?
  /// JSON array of SHA-256 hashes of the unused one-time recovery codes.
  twoFactorRecoveryCodes String?
  /// Last accepted 30-second time step, so a code cannot be used twice.
  twoFactorLastStep      Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization        Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens       RefreshToken[]
  ownedProjects       Project[]         @relation("ProjectOwner")
  memberships         ProjectMember[]
  photo               UserPhoto?
  conversationsA      Conversation[]    @relation("ConversationUserA")
  conversationsB      Conversation[]    @relation("ConversationUserB")
  directMessages      DirectMessage[]   @relation("DirectMessageSender")
  feedback            Feedback[]
  taskAssignments     TaskAssignee[]
  createdTasks        Task[]            @relation("TaskCreator")
  ownedMilestones     Milestone[]       @relation("MilestoneOwner")
  reportedIssues      Issue[]           @relation("IssueReporter")
  assignedIssues      Issue[]           @relation("IssueAssignee")
  timeEntries         TimeEntry[]       @relation("TimeEntryUser")
  approvedTimeEntries TimeEntry[]       @relation("TimeEntryApprover")
  comments            Comment[]
  activities          Activity[]
  notifications       Notification[]
  favoriteProjects    ProjectFavorite[]
  automations         Automation[]
  meetings            Meeting[]

  @@index([organizationId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  /// "Keep me signed in": longer lifetime and a persistent cookie.
  persistent Boolean   @default(false)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Configurable, per-organization values: task/issue/project statuses,
/// priorities and issue severities.
model Lookup {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  name           String
  color          String
  category       String?
  position       Int      @default(0)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectsWithStatus Project[]    @relation("ProjectStatus")
  tasksWithStatus    Task[]       @relation("TaskStatus")
  tasksWithPriority  Task[]       @relation("TaskPriority")
  issuesWithStatus   Issue[]      @relation("IssueStatus")
  issuesWithPriority Issue[]      @relation("IssuePriority")
  issuesWithSeverity Issue[]      @relation("IssueSeverity")

  @@unique([organizationId, type, name])
  @@index([organizationId, type])
}

model Project {
  id             String    @id @default(cuid())
  organizationId String
  key            String
  name           String
  description    String?
  color          String?
  statusId       String
  ownerId        String
  startDate      DateTime?
  endDate        DateTime?
  budgetHours    Float?
  isArchived     Boolean   @default(false)
  taskCounter    Int       @default(0)
  issueCounter   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status       Lookup            @relation("ProjectStatus", fields: [statusId], references: [id], onDelete: Restrict)
  owner        User              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  taskLists    TaskList[]
  tasks        Task[]
  milestones   Milestone[]
  issues       Issue[]
  timeEntries  TimeEntry[]
  activities   Activity[]
  favorites    ProjectFavorite[]
  automations  Automation[]
  customFields CustomField[]
  meetings     Meeting[]

  @@unique([organizationId, key])
  @@index([organizationId, isArchived])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

/// A project a user starred; shown under Favorites in the sidebar.
model ProjectFavorite {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  startDate   DateTime?
  dueDate     DateTime
  ownerId     String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User?      @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  taskLists TaskList[]
  tasks     Task[]
  issues    Issue[]

  @@index([projectId, dueDate])
}

model TaskList {
  id          String   @id @default(cuid())
  projectId   String
  milestoneId String?
  name        String
  /// Hex color of the group header on the project table.
  color       String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([projectId])
}

model Task {
  id                 String    @id @default(cuid())
  projectId          String
  taskListId         String?
  milestoneId        String?
  parentId           String?
  number             Int
  title              String
  description        String?
  statusId           String
  priorityId         String
  startDate          DateTime?
  dueDate            DateTime?
  /// Due date the "due soon" / "overdue" reminders were last sent for (a new due date re-arms them).
  dueSoonNotifiedFor DateTime?
  overdueNotifiedFor DateTime?
  estimatedHours     Float?
  progress           Int       @default(0)
  position           Float     @default(0)
  createdById        String
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskList     TaskList?          @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  milestone    Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parent       Task?              @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks     Task[]             @relation("Subtasks")
  status       Lookup             @relation("TaskStatus", fields: [statusId], references: [id], onDelete: Restrict)
  priority     Lookup             @relation("TaskPriority", fields: [priorityId], references: [id], onDelete: Restrict)
  createdBy    User               @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignees    TaskAssignee[]
  predecessors TaskDependency[]   @relation("DependencySuccessor")
  successors   TaskDependency[]   @relation("DependencyPredecessor")
  comments     Comment[]
  timeEntries  TimeEntry[]
  issues       Issue[]
  customValues CustomFieldValue[]

  @@unique([projectId, number])
  @@index([projectId, statusId])
  @@index([dueDate])
}

model TaskAssignee {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskDependency {
  id            String   @id @default(cuid())
  predecessorId String
  successorId   String
  type          String
  createdAt     DateTime @default(now())

  predecessor Task @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
}

model Issue {
  id                 String    @id @default(cuid())
  projectId          String
  number             Int
  title              String
  description        String?
  statusId           String
  priorityId         String
  severityId         String
  reporterId         String
  assigneeId         String?
  milestoneId        String?
  taskId             String?
  dueDate            DateTime?
  /// Due date the "due soon" / "overdue" reminders were last sent for (a new due date re-arms them).
  dueSoonNotifiedFor DateTime?
  overdueNotifiedFor DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status      Lookup      @relation("IssueStatus", fields: [statusId], references: [id], onDelete: Restrict)
  priority    Lookup      @relation("IssuePriority", fields: [priorityId], references: [id], onDelete: Restrict)
  severity    Lookup      @relation("IssueSeverity", fields: [severityId], references: [id], onDelete: Restrict)
  reporter    User        @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee    User?       @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  milestone   Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  task        Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  comments    Comment[]
  timeEntries TimeEntry[]

  @@unique([projectId, number])
  @@index([projectId, statusId])
  @@index([assigneeId])
}

model TimeEntry {
  id             String    @id @default(cuid())
  userId         String
  projectId      String
  taskId         String?
  issueId        String?
  date           DateTime
  minutes        Int
  notes          String?
  isBillable     Boolean   @default(true)
  approvalStatus String
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User    @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?   @relation("TimeEntryApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  issue      Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([projectId, date])
}

model Comment {
  id        String   @id @default(cuid())
  authorId  String
  taskId    String?
  issueId   String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author      User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  task        Task?               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  issue       Issue?              @relation(fields: [issueId], references: [id], onDelete: Cascade)
  attachments CommentAttachment[]

  @@index([taskId])
  @@index([issueId])
}

/// A person's profile photo (shown wherever their avatar appears). Kept in the database, like comment images.
model UserPhoto {
  userId    String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// An image attached to a comment. Uploaded before the comment is posted (commentId empty until then);
/// unused uploads are cleared after a day. Stored in the database so no file storage service is needed.
model CommentAttachment {
  id         String   @id @default(cuid())
  commentId  String?
  /// Project of the task or issue it was uploaded for: decides who may see it.
  projectId  String
  uploaderId String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([uploaderId, createdAt])
}

model Activity {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  actorId        String
  entityType     String
  entityId       String
  action         String
  summary        String
  metadata       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// "When <trigger> then <action>" rule that runs on a project's items (see automation.constants.ts).
model Automation {
  id           String    @id @default(cuid())
  projectId    String
  name         String
  trigger      String
  /// Narrows the trigger (status, priority or user id); null matches any value.
  triggerValue String?
  action       String
  /// Parameter of the action (status/priority/user/group id or a number of days).
  actionValue  String?
  isActive     Boolean   @default(true)
  runCount     Int       @default(0)
  lastRunAt    DateTime?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId, trigger, isActive])
}

/// Extra column on a project's main table (see custom-field.constants.ts for the types).
model CustomField {
  id        String   @id @default(cuid())
  projectId String
  name      String
  type      String
  /// JSON array of { id, label, color } for dropdown columns.
  options   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  CustomFieldValue[]

  @@index([projectId, position])
}

/// A task's value in a custom column, stored as JSON.
model CustomFieldValue {
  id        String   @id @default(cuid())
  fieldId   String
  taskId    String
  value     String
  updatedAt DateTime @updatedAt

  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  task  Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([fieldId, taskId])
  @@index([taskId])
}

/// A scheduled call with a link to join. Project meetings are shown to the project's members,
/// meetings without a project to the whole organization (see meeting.constants.ts for the types).
model Meeting {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String?
  title          String
  description    String?
  type           String
  link           String
  startsAt       DateTime
  endsAt         DateTime
  /// When the start-of-day reminder went out (cleared when the meeting is rescheduled).
  reminderSentAt DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, startsAt])
  @@index([projectId, startsAt])
}

/// Installation-wide switches root admins change from the platform console (key → JSON value).
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Rate-limit counters shared by every server instance (serverless functions keep no memory between requests).
model RateLimit {
  key          String    @id
  hits         Int
  /// End of the counting window that started with the first hit.
  expiresAt    DateTime
  /// Set once the limit is reached: hits are refused until then.
  blockedUntil DateTime?
  /// Whether the latest hit was refused.
  rejected     Boolean   @default(false)

  @@index([expiresAt])
}

/// A one-to-one chat between two people of an organization (userA is the smaller id, so a pair has one chat).
model Conversation {
  id             String    @id @default(cuid())
  organizationId String
  userAId        String
  userBId        String
  /// When each side last read the chat; newer messages from the other side count as unread.
  userAReadAt    DateTime?
  userBReadAt    DateTime?
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())

  userA    User            @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User            @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([organizationId, userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
}

/// Suggestions on how the app could be better. Anyone can send one; only root admins can read them.
model Feedback {
  id             String    @id @default(cuid())
  userId         String
  /// Organization the person was working in when they wrote it (empty for root admins in the console).
  organizationId String?
  body           String
  /// The page they were on, for context.
  page           String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

/// An image sent in a chat. Uploaded before the message is sent (messageId empty until then).
model MessageAttachment {
  id             String   @id @default(cuid())
  messageId      String?
  conversationId String
  uploaderId     String
  mimeType       String
  size           Int
  data           Bytes
  createdAt      DateTime @default(now())

  message DirectMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId, createdAt])
}
