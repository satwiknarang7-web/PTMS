# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
APP_NAME="Project Tracker"
PORT=4000
API_PREFIX=api
# Comma separated list of browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
# Public address of the web app, used in invitation and password reset links.
# Leave empty to use the address the request came from.
APP_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL. Locally: `docker compose up -d db` matches the defaults below.
# Supabase: DATABASE_URL = transaction pooler (port 6543, add ?pgbouncer=true&connection_limit=1),
#           DIRECT_URL   = session pooler or direct connection (port 5432), used by `prisma db push`.
# Append &schema=ptms (or ?schema=ptms) to both to keep the tables in their own schema.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/segueit?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/segueit?schema=public"

# ─── Authentication ───────────────────────────────────────────
JWT_ACCESS_SECRET=__GENERATE_SECRET__
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=__GENERATE_SECRET__
JWT_REFRESH_EXPIRES_IN=7d
# Session length when "Keep me signed in" is ticked
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
ACCESS_COOKIE_NAME=sptms_at
REFRESH_COOKIE_NAME=sptms_rt
# Organization the root account has opened from the platform console
ROOT_WORKSPACE_COOKIE_NAME=sptms_ws
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# ─── Email (SMTP) ─────────────────────────────────────────────
# Sends invitations and password reset links. With SMTP_HOST empty (development only),
# emails are written to the API log instead. Gmail / Google Workspace: smtp.gmail.com, port 587,
# your address as SMTP_USER and an App Password as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SegueIT Projects <no-reply@segueit.com>"
INVITE_EXPIRES_HOURS=72
PASSWORD_RESET_EXPIRES_MINUTES=60

# ─── Rate limiting ────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=20
# Failed sign-ins per account before it is locked for LOGIN_LOCKOUT_MINUTES (stops password guessing
# from rotating IP addresses)
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# ─── Meetings ─────────────────────────────────────────────────
# Hour of the day (organization time zone) when everyone is told about that day's meetings
MEETING_DIGEST_HOUR=8

# ─── Pagination ───────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200

# ─── Seed (`npm run db:seed`) ─────────────────────────────────
# The seed creates the first root admin (see prisma/seed-data.ts); these override it.
ROOT_EMAIL=
ROOT_PASSWORD=
